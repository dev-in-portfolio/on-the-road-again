# Server-Side Turso Credentials (Used in Netlify Functions)
# Never expose these in client code or prepend with VITE_
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Geoapify API key for address autocomplete and geocoding
# Get your key at https://www.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here
